{
  "name": "@feng0531/dsh-code-report",
  "version": "1.0.5",
  "private": false,
  "type": "module",
  "description": "比较多个 Git/SVN 项目的版本差异，生成改动、接口影响与 QA 测试范围报告。",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh-CN.json": "./locale/zh-CN.json"
  },
  "files": [
    "index.mjs",
    "src/*.mjs",
    "dist/client.js",
    "dist/build-provenance.json",
    "cordis.patch.yml",
    "locale/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE-NOTES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "check": "npm run check:static && npm test",
    "check:static": "node scripts/static-check.mjs",
    "test:coverage": "node build.mjs && node --experimental-test-coverage --test test/*.test.mjs",
    "test:browser": "node build.mjs && playwright test",
    "verify:package": "node scripts/package.mjs",
    "test:install": "node scripts/install.mjs",
    "release:npm": "node scripts/release.mjs npm",
    "release:github": "node scripts/release.mjs github"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/f-e-n-g-0531/dsh-code-report.git"
  }
}
